# Server Configuration
PORT=3000

# ABES ERP Session Credentials (Retrieved from an authorized browser session)
# DO NOT commit real values to version control!
ERP_MYAUTH=
ERP_ASP_NET_SESSION_ID=

# Rate Limiting Configuration (per client IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# Upstream ERP Request Timeout (in milliseconds)
ERP_TIMEOUT_MS=10000
