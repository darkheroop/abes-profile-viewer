# Server Configuration
PORT=3000

# ABES ERP Account Credentials (for automated server-side login)
# DO NOT commit real values to version control!
ERP_USERNAME=
ERP_PASSWORD=

# ABES ERP Session Cookies (optional alternative if using pre-authorized browser session)
ERP_MYAUTH=
ERP_ASP_NET_SESSION_ID=

# Rate Limiting Configuration (per client IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# Upstream ERP Request Timeout (in milliseconds)
ERP_TIMEOUT_MS=10000

# ERP Session Keep-Alive Configuration
ERP_KEEPALIVE_ENABLED=true
ERP_KEEPALIVE_INTERVAL_MINUTES=10

# Optional API Key Authentication (Protects backend from unauthorized external callers)
# Example: abes_live_3a86eb7e7d0d7bc20394f6a8c41594d8 (leave empty to disable)
API_KEY=

# Optional CORS Origin (defaults to * for open frontend access)
CORS_ORIGIN=*
